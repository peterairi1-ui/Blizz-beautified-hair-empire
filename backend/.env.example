PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/blizz-beautified-hair-empire
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=hello@blizzbeautified.com
UPLOADS_DIR=./uploads
DEFAULT_ADMIN_EMAIL=admin@blizzbeautified.com
# Optional: provide a secure DEFAULT_ADMIN_PASSWORD to avoid generating a temporary password
# DEFAULT_ADMIN_PASSWORD=someSecurePassword
